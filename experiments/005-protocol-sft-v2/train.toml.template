max_steps = __MAX_STEPS__
output_dir = "outputs/sft"
clean = true
dashboard = false

[run]
name = "protocol-sft-train-v2"

[model]
name = "empero-ai/Qwen3.8-4B-Distill"
impl = "custom"
attn = "flash_attention_2"
seq_len = __SEQUENCE_LENGTH__
optimization_dtype = "bfloat16"
reduce_dtype = "bfloat16"
compile = "None"

[model.lora]
rank = 16
alpha = 32
dropout = 0.0

[data]
name = "outputs/sft/protocol-sft-v2/prime"
splits = ["train"]
seq_len = __SEQUENCE_LENGTH__
batch_size = 1
micro_batch_size = 1
num_workers = 1
shuffle = true
seed = __DATASET_SEED__

[data.loss_mask]
system = false
user = false
assistant = true
tool = false

[renderer]
name = "qwen3.5"
enable_thinking = false

[optim]
lr = 1e-4
weight_decay = 0.0

[ckpt]

[deployment]
gpus_per_node = 1
num_train_gpus = 1
