{
  "schema_version": 1,
  "benchmark_config_id": "benchmark-v1",
  "postgresql": {
    "server_version_num": "180006",
    "extension_name": "pg_hint_plan",
    "extension_version": "1.8.0",
    "data_checksums": "on",
    "database_encoding": "UTF8",
    "database_collation": "C",
    "database_ctype": "C"
  },
  "settings": {
    "shared_preload_libraries": "pg_hint_plan",
    "pg_hint_plan.enable_hint": "on",
    "pg_hint_plan.enable_hint_table": "off",
    "pg_hint_plan.debug_print": "off",
    "pg_hint_plan.message_level": "log",
    "pg_hint_plan.parse_messages": "info",
    "autovacuum": "off",
    "max_logical_replication_workers": "0",
    "huge_pages": "off",
    "dynamic_shared_memory_type": "posix",
    "shared_buffers": "16384",
    "effective_cache_size": "524288",
    "work_mem": "4096",
    "hash_mem_multiplier": "2",
    "temp_buffers": "1024",
    "maintenance_work_mem": "65536",
    "default_statistics_target": "100",
    "constraint_exclusion": "partition",
    "cursor_tuple_fraction": "0.1",
    "recursive_worktable_factor": "10",
    "plan_cache_mode": "auto",
    "from_collapse_limit": "8",
    "join_collapse_limit": "8",
    "geqo": "on",
    "geqo_threshold": "12",
    "geqo_effort": "5",
    "geqo_pool_size": "0",
    "geqo_generations": "0",
    "geqo_selection_bias": "2",
    "geqo_seed": "0",
    "seq_page_cost": "1",
    "random_page_cost": "4",
    "cpu_tuple_cost": "0.01",
    "cpu_index_tuple_cost": "0.005",
    "cpu_operator_cost": "0.0025",
    "effective_io_concurrency": "16",
    "maintenance_io_concurrency": "16",
    "io_method": "worker",
    "io_workers": "3",
    "io_max_concurrency": "64",
    "io_combine_limit": "16",
    "io_max_combine_limit": "16",
    "enable_async_append": "on",
    "enable_bitmapscan": "on",
    "enable_distinct_reordering": "on",
    "enable_gathermerge": "on",
    "enable_group_by_reordering": "on",
    "enable_hashagg": "on",
    "enable_hashjoin": "on",
    "enable_incremental_sort": "on",
    "enable_indexonlyscan": "on",
    "enable_indexscan": "on",
    "enable_material": "on",
    "enable_memoize": "on",
    "enable_mergejoin": "on",
    "enable_nestloop": "on",
    "enable_parallel_append": "on",
    "enable_parallel_hash": "on",
    "enable_partition_pruning": "on",
    "enable_partitionwise_aggregate": "off",
    "enable_partitionwise_join": "off",
    "enable_presorted_aggregate": "on",
    "enable_self_join_elimination": "on",
    "enable_seqscan": "on",
    "enable_sort": "on",
    "enable_tidscan": "on",
    "max_worker_processes": "8",
    "max_parallel_workers": "8",
    "max_parallel_workers_per_gather": "2",
    "max_parallel_maintenance_workers": "2",
    "min_parallel_table_scan_size": "1024",
    "min_parallel_index_scan_size": "64",
    "parallel_setup_cost": "1000",
    "parallel_tuple_cost": "0.1",
    "parallel_leader_participation": "on",
    "jit": "off",
    "jit_provider": "llvmjit",
    "jit_above_cost": "100000",
    "jit_inline_above_cost": "500000",
    "jit_optimize_above_cost": "500000",
    "track_io_timing": "off",
    "track_wal_io_timing": "off",
    "synchronize_seqscans": "on",
    "statement_timeout": "0",
    "lock_timeout": "0",
    "idle_in_transaction_session_timeout": "0",
    "TimeZone": "UTC",
    "log_timezone": "UTC",
    "log_line_prefix": "%m [%p] ",
    "fsync": "on",
    "full_page_writes": "on",
    "synchronous_commit": "on",
    "max_connections": "100",
    "password_encryption": "scram-sha-256"
  },
  "agent_role_settings": {
    "default_transaction_read_only": "on",
    "transaction_read_only": "on",
    "search_path": "public, pg_catalog"
  },
  "forbidden_backend_types": [
    "autovacuum launcher",
    "autovacuum worker",
    "logical replication launcher",
    "logical replication worker"
  ],
  "runtime": {
    "cpuset_cpus": "8-15,24-31",
    "cpuset_mems": "0",
    "memory_max_bytes": "34359738368",
    "memory_swap_max_bytes": "0",
    "shm_size_bytes": "1073741824"
  }
