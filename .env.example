# Development-only values. Replace these before starting the container.
QORL_POSTGRES_PASSWORD="replace-with-a-long-random-admin-password"
QORL_RUNNER_PASSWORD="replace-with-a-long-random-runner-password"

# Optional model-server authentication and run-config override:
QORL_MODEL_API_KEY=""
QORL_RUN_CONFIG="experiments/000-vanilla-baseline/run.json"

# Frontier model API keys
OPENAI_API_KEY="replace-with-an-openai-api-key"
OPENROUTER_API_KEY="replace-with-an-openrouter-api-key"
